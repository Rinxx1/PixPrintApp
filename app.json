{
  "expo": {
    "name": "Snapture",
    "slug": "pixprintapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "snapture",
    "splash": {
      "image": "./assets/icon-pix-print.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "plugins": [
      "expo-camera"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixprintstudio.snapture",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to take photos for events and instant printing.",
        "NSMicrophoneUsageDescription": "This app needs access to microphone to record audio with photos for enhanced memories.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to save and share your captured moments.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to save photos to your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["background-processing"]
      },
      "associatedDomains": ["applinks:snapture.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.pixprintstudio.snapture"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "72d04b40-439a-42cb-a136-8bc9879e4451"
      }
    },
    "owner": "rinxx14"
  }
}
