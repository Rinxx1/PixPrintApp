{
  "expo": {
    "name": "Pix Print",
    "slug": "pixprintapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-pix-print.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "plugins": [
      "expo-camera"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pix.print.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to take photos.",
        "NSMicrophoneUsageDescription": "This app needs access to microphone to record audio with photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "pix.print.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "72d04b40-439a-42cb-a136-8bc9879e4451"
      }
    },
    "owner": "rinxx14"
  }
}
